page { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #24211d; background: #f6f2e9; }
button { font-size: 28rpx; font-weight: 500; border-radius: 18rpx; margin: 0; padding: 0 24rpx; min-height: 80rpx; line-height: 2.8; box-sizing: border-box; }
button::after { border: none; }
button[disabled] { opacity: .40; }
