<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F6F2E9">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:src="@drawable/ic_moying" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/app_name" android:textSize="30sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/brand_tagline" android:textColor="#746E64" android:textSize="16sp" />
        <Button android:id="@+id/theme" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/theme_title" />
        <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="先开启蓝牙，再扫描附近的墨水屏。" android:textColor="#24211D"
            android:textSize="16sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="扫描墨水屏" />
        <Spinner android:id="@+id/devices" android:layout_width="match_parent" android:layout_height="48dp"
            android:contentDescription="选择附近的墨水屏" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/connect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="连接" />
            <Button android:id="@+id/disconnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="断开" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="图片预览" android:textSize="20sp" android:textStyle="bold" android:textColor="#24211D" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <ImageView android:id="@+id/preview" android:layout_width="0dp" android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,552:768"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                android:background="#FFFFFF" android:scaleType="fitCenter" android:contentDescription="发送到墨水屏的竖向四色图片预览" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView android:id="@+id/image_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="请选择一张图片，系统将保留完整画面。" android:textColor="#746E64" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/choose" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="选择图片" />
            <Button android:id="@+id/rotate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="旋转 90°" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/zoom_value" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="图片大小 · 100%" android:textSize="16sp" />
            <Button android:id="@+id/fit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/zoom_fit" />
        </LinearLayout>
        <SeekBar android:id="@+id/zoom" android:layout_width="match_parent" android:layout_height="48dp"
            android:min="25" android:max="300" android:progress="100"
            android:contentDescription="@string/zoom_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/zoom_hint" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/depth_title" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/red_depth_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:labelFor="@id/red_depth" android:textSize="16sp" />
        <SeekBar android:id="@+id/red_depth" android:layout_width="match_parent" android:layout_height="48dp"
            android:min="0" android:max="200" android:progress="100" android:contentDescription="@string/red_depth_description" />
        <TextView android:id="@+id/black_depth_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:labelFor="@id/black_depth" android:textSize="16sp" />
        <SeekBar android:id="@+id/black_depth" android:layout_width="match_parent" android:layout_height="48dp"
            android:min="0" android:max="200" android:progress="100" android:contentDescription="@string/black_depth_description" />
        <TextView android:id="@+id/yellow_depth_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:labelFor="@id/yellow_depth" android:textSize="16sp" />
        <SeekBar android:id="@+id/yellow_depth" android:layout_width="match_parent" android:layout_height="48dp"
            android:min="0" android:max="200" android:progress="100" android:contentDescription="@string/yellow_depth_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/depth_hint" android:textSize="13sp" />
        <Button android:id="@+id/reset_depth" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/depth_reset" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/style_title" android:labelFor="@id/image_style"
            android:textSize="18sp" android:textStyle="bold" />
        <Spinner android:id="@+id/image_style" android:layout_width="match_parent" android:layout_height="48dp"
            android:contentDescription="@string/style_title" />
        <TextView android:id="@+id/style_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/style_default_hint" android:textSize="13sp" />
        <CheckBox android:id="@+id/invert" android:layout_width="match_parent" android:layout_height="48dp" android:text="颜色反转" android:textColor="#24211D" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="16dp" android:max="100" android:contentDescription="图片传输进度" />
        <Button android:id="@+id/send" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="发送到墨水屏" />
        <Button android:id="@+id/clear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清屏为白色" />
        <Button android:id="@+id/update_firmware" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="选择固件并更新设备" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="发送时请保持手机靠近设备。传输完成后仍需等待屏幕刷新；应用提示完成前，请勿关闭设备电源。"
            android:textColor="#746E64" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
